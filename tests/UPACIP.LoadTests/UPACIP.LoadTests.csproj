<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>UPACIP.LoadTests</AssemblyName>
    <RootNamespace>UPACIP.LoadTests</RootNamespace>
    <!-- Suppress warnings that appear in generated NBomber internals -->
    <NoWarn>CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- NBomber 5.2.0 core — .NET-native load testing (US_082 task_002).
         HTTP scenarios use raw System.Net.Http.HttpClient so NBomber.Http is not
         required; dropping it eliminates the NBomber.Contracts version conflict
         (NBomber 5.2.0 pins Contracts=5.1.1 while NBomber.Http 5.2.0 needs >=5.6.0). -->
    <PackageReference Include="NBomber" Version="5.2.0" />
    <!-- Direct PostgreSQL access for TestDataSeeder (avoids cross-project coupling) -->
    <PackageReference Include="Npgsql" Version="9.0.0" />
    <!-- Configuration infrastructure -->
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="8.0.0" />
    <!-- xUnit assertions (assertion-only, no test runner) -->
    <PackageReference Include="xunit" Version="2.9.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.LoadTest.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
