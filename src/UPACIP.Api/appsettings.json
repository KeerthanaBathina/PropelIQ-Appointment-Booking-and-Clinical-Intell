{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=upacip;Username=upacip_app;Password=REPLACE_WITH_SECRET;Maximum Pool Size=100;Timeout=30;SSL Mode=Require;Trust Server Certificate=false"
  },
  "Redis": {
    "ConnectionString": "{upstash-endpoint}:{port},password=REPLACE_WITH_SECRET,ssl=True,abortConnect=False"
  },
  "CorsSettings": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5000"
      },
      "Https": {
        "Url": "https://localhost:5001",
        "Certificate": {
          "Path": "C:\\Certificates\\upacip.pfx",
          "Password": "REPLACE_WITH_SECRET"
        }
      }
    }
  },
  "JwtSettings": {
    "Issuer": "upacip-api",
    "Audience": "upacip-clients",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "FeatureManagement": {
    "AiDocumentParsing": false,
    "SmsNotifications": false,
    "ConversationalIntake": false,
    "WaitlistManagement": true
  },
  "Calibration": {
    "IntervalDays": 7
  },
  "AIGatewayOptions": {
    "ProviderPriority": [ "openai", "anthropic" ],
    "ExpectedModelVersions": {
      "openai":    "gpt-4o-mini",
      "anthropic": "claude-3-5-sonnet-20241022"
    },
    "DocumentParsingMaxInputTokens":       4096,
    "DocumentParsingMaxOutputTokens":      1024,
    "ConversationalIntakeMaxInputTokens":  500,
    "ConversationalIntakeMaxOutputTokens": 200,
    "MedicalCodingMaxInputTokens":         2048,
    "MedicalCodingMaxOutputTokens":        500,
    "MaxPromptSizeBytes":                  65536
  },
  "AiGateway": {
    "OpenAiApiKey": "REPLACE_WITH_SECRET",
    "OpenAiModel": "gpt-4o-mini",
    "OpenAiBaseUrl": "https://api.openai.com",
    "AnthropicApiKey": "REPLACE_WITH_SECRET",
    "AnthropicModel": "claude-3-5-sonnet-20241022",
    "AnthropicBaseUrl": "https://api.anthropic.com",
    "TimeoutSeconds": 10
  },
  "AIGateway": {
    "Providers": {
      "OpenAI": {
        "ApiKey": "REPLACE_WITH_SECRET",
        "BaseUrl": "https://api.openai.com/v1",
        "Model": "gpt-4o-mini",
        "ModelVersion": "2024-07-18",
        "TimeoutSeconds": 30
      },
      "Claude": {
        "ApiKey": "REPLACE_WITH_SECRET",
        "BaseUrl": "https://api.anthropic.com/v1",
        "Model": "claude-3-5-sonnet-20241022",
        "AnthropicVersion": "2023-06-01",
        "TimeoutSeconds": 30
      }
    },
    "Resilience": {
      "CircuitBreakerFailureThreshold": 5,
      "CircuitBreakerBreakDurationSeconds": 30,
      "RetryMaxAttempts": 3,
      "RetryBaseDelaySeconds": 1
    },
    "Queue": {
      "QueueKey": "ai-gateway:document-parsing:queue",
      "DeadLetterKey": "ai-gateway:document-parsing:dead-letter",
      "MaxConcurrentWorkers": 3,
      "MaxQueueDepth": 100,
      "PollingIntervalMs": 500,
      "MaxRetries": 3,
      "DefaultPriority": "Normal",
      "ShutdownDrainTimeoutSeconds": 30,
      "MonitoringIntervalSeconds": 30
    },
    "TokenBudgets": {
      "RequestTypeBudgets": {
        "DocumentParsing": {
          "MaxInputTokens": 4000,
          "MaxOutputTokens": 1000
        },
        "ConversationalIntake": {
          "MaxInputTokens": 500,
          "MaxOutputTokens": 200
        },
        "MedicalCoding": {
          "MaxInputTokens": 2000,
          "MaxOutputTokens": 500
        }
      }
    }
  },
  "ClinicSettings": {
    "Name": "UPACIP Medical Clinic",
    "TimeZoneId": "America/New_York",
    "Domain": "upacip.clinic",
    "PortalBaseUrl": "https://portal.upacip.clinic"
  },
  "EmailProvider": {
    "DeliveryTimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "EnableFallback": true,
    "Primary": {
      "ProviderName": "SendGrid",
      "Host": "smtp.sendgrid.net",
      "Port": 587,
      "Username": "apikey",
      "Password": "REPLACE_WITH_SECRET",
      "FromAddress": "noreply@upacip.clinic",
      "FromName": "UPACIP Medical",
      "DailyQuotaLimit": 100
    },
    "Fallback": {
      "ProviderName": "Gmail",
      "Host": "smtp.gmail.com",
      "Port": 587,
      "Username": "REPLACE_WITH_GMAIL_ADDRESS",
      "Password": "REPLACE_WITH_SECRET",
      "FromAddress": "REPLACE_WITH_GMAIL_ADDRESS",
      "FromName": "UPACIP Medical",
      "DailyQuotaLimit": 0
    }
  },
  "SmsProvider": {
    "AccountSid": "REPLACE_WITH_SECRET",
    "AuthToken": "REPLACE_WITH_SECRET",
    "FromNumber": "REPLACE_WITH_TWILIO_PHONE_NUMBER",
    "DeliveryTimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "SmsEnabled": true,
    "AllowedCountryCode": "+1"
  },
  "DocumentStorage": {
    "StoragePath": "C:\\UploadedDocuments"
  },
  "DocumentParsing": {
    "MaxConcurrentJobs": 5,
    "PollingIntervalSeconds": 5,
    "MaxRetryAttempts": 3
  },
  "QueueSettings": {
    "WaitTimeThresholdMinutes": 30
  },
  "AuditSettings": {
    "QueryMaxPageSize": 200,
    "QueryDefaultPageSize": 50,
    "RetentionYears": 7
  },
  "AuditQueue": {
    "RedisQueueKey": "audit:failover:queue",
    "FlushBatchSize": 100,
    "FlushIntervalMs": 5000,
    "IdleIntervalMs": 30000,
    "CircuitBreakerFailureThreshold": 5,
    "CircuitBreakerDurationSeconds": 30,
    "MaxRetryAttempts": 3,
    "LocalFallbackPath": "logs/audit-failover-{date}.json"
  },
  "Security": {
    "Tls": {
      "MinimumProtocolVersion": "Tls12",
      "CertificatePath": "",
      "HstsMaxAgeDays": 365,
      "CertExpiryWarningDays": 30
    },
    "Encryption": {
      "Key": "REPLACE_WITH_BASE64_ENCODED_32_BYTE_AES256_KEY",
      "Algorithm": "AES-256-CBC",
      "KeyVersion": 1
    }
    },
  "PiiRedaction": {
    "PiiFieldNames": [
      "Email",
      "PhoneNumber",
      "Phone",
      "Ssn",
      "SocialSecurityNumber",
      "DateOfBirth",
      "Dob",
      "BirthDate",
      "FirstName",
      "LastName",
      "PatientName",
      "FullName",
      "Name"
    ],
    "PiiPatterns": {
      "Email": "^[\\w._%+\\-]+@[\\w.\\-]+\\.\\w{2,}$",
      "Phone": "^\\+?\\d[\\d\\s()\\-]{7,}$",
      "Ssn":   "^\\d{3}-?\\d{2}-?\\d{4}$"
    }
  },
  "AiCost": {
    "AggregationScheduleHours": 24,
    "RunningCostCacheTtlMinutes": 5
  },
  "AiQueue": {
    "MonitorIntervalSeconds": 60,
    "StaleWarningMinutes": 5,
    "EscalationDepthThreshold": 50
  },
  "HybridSearch": {
    "SemanticWeight": 0.7,
    "KeywordWeight": 0.3,
    "ExactMatchBoostFactor": 2.0,
    "EnableExactMatchBoosting": true
  }
}
